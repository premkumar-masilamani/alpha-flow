#!/usr/bin/env bash
#
# Pre-commit gate: run lint, unit tests, and integration tests locally before
# every commit. Integration tests boot the Firebase emulators (requires Java),
# which the vitest globalSetup starts automatically.
#

set -euo pipefail

# Run from the repository root regardless of where git invoked the hook.
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "pre-commit: lint"
make lint

echo "pre-commit: unit tests"
make test

echo "pre-commit checks passed"
