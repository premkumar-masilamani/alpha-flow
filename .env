PROJECT_NAME=ta
DOCKER_NETWORK=ta_network

DOCKER_IMAGE_POSTGRES=postgres:16-bookworm
DOCKER_IMAGE_DB_MIGRATE=migrate/migrate:4
DOCKER_IMAGE_NODE=node:24.4-alpine

POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=ta_db
POSTGRES_PORT=5433

LOCAL_SCRIPTS_VOLUME=./database/scripts
LOCAL_SEED_DATA_VOLUME=./database/data
LOCAL_MIGRATION_DATA_VOLUME=./database/migrations

DOCKER_SCRIPTS_VOLUME=/app/scripts
DOCKER_SEED_DATA_VOLUME=/app/data
DOCKER_MIGRATION_DATA_VOLUME=/app/migrations

NEXT_PUBLIC_API_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
