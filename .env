# Change the below four variables if this
# .env file is copied from another project
DOCKER_NETWORK_NAME=ta_network
POSTGRES_DB=ta_db
POSTGRES_VOLUME=ta_postgres_data
POSTGRES_PORT=5432

# Don't change the below variables
DOCKER_IMAGE_POSTGRES=postgres:16-bookworm
DOCKER_IMAGE_DB_MIGRATE=migrate/migrate:4
DOCKER_IMAGE_NODE=node:24.4-alpine

POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password

LOCAL_SCRIPTS_VOLUME=./database/scripts
LOCAL_SEED_DATA_VOLUME=./database/data
LOCAL_MIGRATION_DATA_VOLUME=./database/migrations

DOCKER_SCRIPTS_VOLUME=/app/scripts
DOCKER_SEED_DATA_VOLUME=/app/data
DOCKER_MIGRATION_DATA_VOLUME=/app/migrations

DIAGRAMS_DIR=docs/diagrams
DATABASE_MIGRATION_DIRECTION=up

NEXT_PUBLIC_API_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
