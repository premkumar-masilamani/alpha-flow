# Makefile for React application

.PHONY: install start build test clean help

install:
	npm install

start:
	npm start

build:
	npm run build

test:
	npm test

clean:
	rm -rf node_modules build

help:
	@echo "Available targets:"
	@echo "  make install  - Install dependencies"
	@echo "  make start    - Run React dev server"
	@echo "  make build    - Create production build"
	@echo "  make test     - Run tests"
	@echo "  make clean    - Remove node_modules and build"
